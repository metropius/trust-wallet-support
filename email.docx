/**
 * ZumaDash Email — Bird.com API OR Zoho CPaaS (admin emailProvider toggle)
 * Path: backend/src/utils/sendEmail.js
 *
 * App imports:  require('../utils/sendEmail')
 *
 * Admin PlatformSettings.emailProvider: 'bird' | 'zoho'
 *
 * Bird:
 *   BIRD_API_KEY, BIRD_REGION, BIRD_FROM_EMAIL, BIRD_FROM_NAME
 *   Auth: AccessKey <key>  → POST {region}.platform.bird.com/v1/email/messages
 *
 * Zoho CPaaS / ZeptoMail:
 *   Prefer SMTP (your agent SMTP panel):
 *     ZOHO_SMTP_HOST=smtp.zeptomail.com
 *     ZOHO_SMTP_PORT=465
 *     ZOHO_SMTP_USER=emailapikey
 *     ZOHO_SMTP_PASS=<password from agent>
 *     ZOHO_FROM_EMAIL=noreply@pmtal.org  (verified domain)
 *   Or REST with agent API key:
 *     ZOHO_CPAAS_API_KEY + ZOHO_FROM_EMAIL
 *     POST https://api.zeptomail.com/v1.1/email  (Authorization: Zoho-enczapikey …)
 */

const nodemailer = require('nodemailer');

function clean(v) {
  return String(v || '')
    .trim()
    .replace(/^["']|["']$/g, '');
}

function getBirdConfig() {
  const apiKey = clean(process.env.BIRD_API_KEY);
  const fromEmail = clean(
    process.env.BIRD_FROM_EMAIL || process.env.FROM_EMAIL || 'support@zumadash.ng'
  );
  const fromName = clean(
    process.env.BIRD_FROM_NAME ||
      process.env.FROM_NAME ||
      process.env.PLATFORM_NAME ||
      'ZumaDash'
  );
  const region = clean(process.env.BIRD_REGION).toLowerCase();
  let baseUrl = 'https://us1.platform.bird.com';
  if (region === 'eu1' || apiKey.includes('_eu1_') || apiKey.startsWith('bk_eu1')) {
    baseUrl = 'https://eu1.platform.bird.com';
  }
  return { apiKey, fromEmail, fromName, baseUrl };
}

function getZohoConfig() {
  const apiKey = clean(process.env.ZOHO_CPAAS_API_KEY || process.env.ZOHO_EMAIL_API_KEY);
  const fromEmail = clean(
    process.env.ZOHO_FROM_EMAIL ||
      process.env.FROM_EMAIL ||
      process.env.BIRD_FROM_EMAIL ||
      'noreply@pmtal.org'
  );
  const fromName = clean(
    process.env.ZOHO_FROM_NAME ||
      process.env.FROM_NAME ||
      process.env.PLATFORM_NAME ||
      'ZumaDash'
  );
  const smtpHost = clean(process.env.ZOHO_SMTP_HOST || 'smtp.zeptomail.com');
  const smtpPort = Number(process.env.ZOHO_SMTP_PORT || 465);
  const smtpUser = clean(process.env.ZOHO_SMTP_USER || 'emailapikey');
  const smtpPass = clean(process.env.ZOHO_SMTP_PASS || process.env.ZOHO_SMTP_PASSWORD);
  const restBase = clean(
    process.env.ZOHO_EMAIL_API_URL || 'https://api.zeptomail.com/v1.1/email'
  );
  return { apiKey, fromEmail, fromName, smtpHost, smtpPort, smtpUser, smtpPass, restBase };
}

function zohoAuthHeader(apiKey) {
  let key = clean(apiKey);
  if (!key) return null;
  if (!/^Zoho-enczapikey\s+/i.test(key)) {
    key = `Zoho-enczapikey ${key}`;
  }
  return key;
}

async function getEmailProvider() {
  try {
    const PlatformSettings = require('../models/PlatformSettings');
    const s = await PlatformSettings.findOne().select('emailProvider messagingProvider').lean();
    const p = (s?.emailProvider || process.env.EMAIL_PROVIDER || 'bird').toLowerCase();
    return p === 'zoho' ? 'zoho' : 'bird';
  } catch (_) {
    return (process.env.EMAIL_PROVIDER || 'bird').toLowerCase() === 'zoho' ? 'zoho' : 'bird';
  }
}

async function sendViaBird({ to, subject, html, text, category }) {
  const { apiKey, fromEmail, fromName, baseUrl } = getBirdConfig();
  if (!apiKey) {
    console.warn('BIRD_API_KEY not set – email skipped:', subject, '→', to);
    return { id: 'dev-skip', provider: 'none' };
  }
  const payload = {
    from: { email: fromEmail, name: fromName },
    to: [to],
    subject,
    html: html || `<p>${subject}</p>`,
    category: category || 'transactional',
  };
  if (text) payload.text = text;

  const url = `${baseUrl}/v1/email/messages`;
  const authHeader = `AccessKey ${apiKey}`;
  console.log('Bird email:', { to, from: fromEmail });

  const res = await fetch(url, {
    method: 'POST',
    headers: {
      Authorization: authHeader,
      'Content-Type': 'application/json',
      Accept: 'application/json',
    },
    body: JSON.stringify(payload),
  });
  const raw = await res.text();
  let data = null;
  try {
    data = raw ? JSON.parse(raw) : null;
  } catch (_) {
    data = { raw };
  }
  if (!res.ok) {
    const errBody = data?.error || data;
    console.error('Bird Email API error:', errBody);
    const err = new Error(
      typeof errBody?.message === 'string' ? errBody.message : 'Bird email send failed'
    );
    err.status = res.status;
    err.data = data;
    throw err;
  }
  return {
    messageId: data?.id,
    status: data?.status,
    provider: 'bird',
    data: data || { id: 'bird-ok' },
  };
}

async function sendViaZohoSmtp({ to, subject, html, text, fromEmail, fromName, smtp }) {
  const transporter = nodemailer.createTransport({
    host: smtp.smtpHost,
    port: smtp.smtpPort,
    secure: smtp.smtpPort === 465,
    auth: {
      user: smtp.smtpUser,
      pass: smtp.smtpPass,
    },
  });
  const mail = {
    from: `"${fromName}" <${fromEmail}>`,
    to,
    subject,
    text: text || undefined,
    html: html || `<p>${subject}</p>`,
  };
  if (arguments[0]?.attachments) {
    // handled below via options threaded — see sendViaZohoSmtp call
  }
  if (smtp.attachments && smtp.attachments.length) {
    mail.attachments = smtp.attachments.map((a) => ({
      filename: a.filename,
      content: a.content,
      contentType: a.contentType || 'application/pdf',
    }));
  }
  const info = await transporter.sendMail(mail);
  console.log('Zoho SMTP accepted:', info.messageId);
  return {
    messageId: info.messageId,
    provider: 'zoho_smtp',
    data: info,
  };
}

async function sendViaZohoRest({ to, subject, html, text, fromEmail, fromName, apiKey, restBase }) {
  const auth = zohoAuthHeader(apiKey);
  if (!auth) {
    throw new Error('ZOHO_CPAAS_API_KEY not set for Zoho email REST');
  }
  // ZeptoMail / CPaaS email body shape
  const payload = {
    from: { address: fromEmail, name: fromName },
    to: [{ email_address: { address: to, name: '' } }],
    subject,
    htmlbody: html || `<p>${subject}</p>`,
  };
  if (text) payload.textbody = text;

  console.log('Zoho email REST:', { url: restBase, to, from: fromEmail });
  const res = await fetch(restBase, {
    method: 'POST',
    headers: {
      Authorization: auth,
      'Content-Type': 'application/json',
      Accept: 'application/json',
    },
    body: JSON.stringify(payload),
  });
  const raw = await res.text();
  let data = null;
  try {
    data = raw ? JSON.parse(raw) : null;
  } catch (_) {
    data = { raw };
  }
  if (!res.ok) {
    console.error('Zoho Email REST error:', data);
    const err = new Error(
      data?.message || data?.error?.message || 'Zoho email send failed'
    );
    err.status = res.status;
    err.data = data;
    throw err;
  }
  return {
    messageId: data?.data?.[0]?.message_id || data?.message_id || data?.request_id,
    provider: 'zoho_rest',
    data,
  };
}

async function sendViaZoho({ to, subject, html, text, attachments }) {
  const z = getZohoConfig();
  // Prefer SMTP when password is configured (matches your agent SMTP panel)
  if (z.smtpPass) {
    try {
      return await sendViaZohoSmtp({
        to,
        subject,
        html,
        text,
        fromEmail: z.fromEmail,
        fromName: z.fromName,
        smtp: { ...z, attachments: attachments || [] },
      });
    } catch (e) {
      console.error('Zoho SMTP failed, trying REST:', e.message);
    }
  }
  if (z.apiKey) {
    return sendViaZohoRest({
      to,
      subject,
      html,
      text,
      fromEmail: z.fromEmail,
      fromName: z.fromName,
      apiKey: z.apiKey,
      restBase: z.restBase,
    });
  }
  console.warn('Zoho email not configured (need ZOHO_SMTP_PASS or ZOHO_CPAAS_API_KEY)');
  return { id: 'dev-skip', provider: 'none' };
}

/**
 * await sendEmail({ email, subject, html })
 * Optional: text, category
 */
async function sendEmail(options) {
  const attachments = options?.attachments || [];
  const to = String(options?.email || options?.to || '').trim();
  const subject = String(options?.subject || '').trim();
  const html = String(options?.html || '');
  const text = options?.text != null ? String(options.text) : undefined;
  const category = options?.category || 'transactional';

  if (!to) throw new Error('sendEmail: recipient email is required');
  if (!subject) throw new Error('sendEmail: subject is required');

  const provider = await getEmailProvider();
  if (provider === 'zoho') {
    return sendViaZoho({ to, subject, html, text, attachments });
  }
  return sendViaBird({ to, subject, html, text, category });
}

module.exports = sendEmail;
module.exports.getEmailProvider = getEmailProvider;





